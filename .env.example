# Public browser configuration only. Never put a Supabase secret/service-role key here.
NEXT_PUBLIC_ELOS_REMOTE_SYNC_MODE=DISABLED
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only (never prefix with NEXT_PUBLIC_). Leave unset on every deployed instance.
# Enables the local NotebookLM browser-automation bridge (POST /api/notebooklm/execute) on a
# trusted local machine only. Without it the route answers 404 and starts nothing.
# ELOS_NOTEBOOKLM_AUTOMATION=ENABLED
